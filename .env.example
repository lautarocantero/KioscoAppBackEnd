# Copiar este archivo a .env y completar los valores reales (nunca commitear .env).

# Cadena de conexión de MongoDB Atlas (o local).
MONGODB_URI=

# Resend (envío de mails: reset de contraseña, etc.)
RESEND_API_KEY=
# Remitente verificado en Resend. En sandbox, onboarding@resend.dev solo entrega
# al dueño de la cuenta — para entregar a destinatarios reales hace falta un
# dominio propio verificado en Resend.
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Stocko

# URL del frontend: se usa como back_url de la preapproval de Mercado Pago
# (a dónde vuelve el usuario tras pagar en el checkout hospedado).
# Local: http://localhost:5173 · Producción: dominio real de Netlify.
FRONTEND_URL=http://localhost:5173

# Mercado Pago (suscripciones/membresías) — ver docs/MercadoPagoSetup.md.
# Sin MP_ACCESS_TOKEN, POST /membership/checkout responde 400.
# Sin MP_WEBHOOK_SECRET, el webhook se rechaza en producción (fail-closed) y
# solo se salta la validación en desarrollo (con warning en consola).
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Secretos de firma de JWT (access/refresh token). El código trae defaults
# hardcodeados de desarrollo — sobreescribir siempre en producción.
ACCESS_SECRET=
REFRESH_SECRET=

# Puerto del servidor (default 3000 si se omite).
PORT=3000

# Rounds de bcrypt para hashear contraseñas (default 10 si se omite).
SALT_ROUNDS=10

# Entorno de ejecución. Setear explícitamente "production" en Render — de eso
# depende, entre otras cosas, que el webhook de Mercado Pago rechace requests
# sin firma válida en vez de solo loguear un warning.
NODE_ENV=development
